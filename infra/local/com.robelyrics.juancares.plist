<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent del daemon de ingesta de YouTube (Juancares + entrevistas).
  Corre en la Mac del user (IP residencial). Polling cada 15 min.

  Instalar (ver infra/local/README.md):
    cp infra/local/com.robelyrics.juancares.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.robelyrics.juancares.plist

  OJO: ProgramArguments lleva la RUTA ABSOLUTA del wrapper. Si mueves el repo,
  edita la ruta y recarga el agent (unload + load).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.robelyrics.juancares</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/david.ruiz/Documents/Claude Code/RobeLyrics/infra/local/juancares_daemon.sh</string>
    </array>

    <!-- Cada 15 minutos. RunAtLoad para una primera pasada al cargar. -->
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- PATH para encontrar docker (Docker Desktop) además de los del sistema. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Applications/Docker.app/Contents/Resources/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/robelyrics_juancares_daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/robelyrics_juancares_daemon.log</string>
</dict>
</plist>
