# Crontab de producción de Entre Interiores.
#
# Cubre dos sistemas:
#   1. Calendario editorial automático del blog.
#   2. Publicación diaria en Instagram (@entreinterioresrobe).
#
# Instalar en el host de producción:
#   ssh robelyrics
#   crontab -l > /tmp/crontab.bak       (backup)
#   crontab -e
#   (pegar contenido de este fichero)
#
# Logs: /var/log/robelyrics-cron.log
#
# FLUJO EDITORIAL (banco de propuestas del blog):
#   1. aggregate (diario)         → noticias de las 27 fuentes a news_items.
#   2. scrape_news (lunes)        → propuestas de blog desde news_items.
#   3. generate_proposals (lunes) → efemérides próximas + evergreens.
#   4. notify_proposals (lunes)   → email al admin con todo el banco.
#   5. El admin programa desde /biblioteca/admin/calendario (máx 2/semana).
#   6. materialize_proposals (diario) → al llegar la fecha, genera el body,
#      crea el Post, lo publica y dispara la newsletter.
#
# FLUJO INSTAGRAM (@entreinterioresrobe):
#   1. aggregate (diario)         → comparte el almacén news_items.
#   2. ig prepare_daily (diario)  → selecciona temas, prepara imagen+caption.
#   3. ig publish_next (3/día)    → cuentagotas: respeta intervalo mínimo.
#   Posts del blog se difunden automáticamente al publicarse.
#
# Las efemérides personales de Robe se publican directas en el día exacto.
# Idempotencia: todos los scripts son seguros de relanzar.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

APP_DIR=/opt/robelyrics
DC="docker compose -f docker-compose.yml -f docker-compose.prod.yml"

# ============================================================================
# Agregador unificado de noticias (alimenta blog + Instagram)
# ============================================================================

# Descarga las 27 fuentes RSS / Google News / Reddit y escribe a news_items.
# Filtra a <=7 días, deduplica por URL, purga las viejas. Diario 07:30 UTC.
30 7 * * * cd $APP_DIR && $DC exec -T api python -m scripts.news.aggregate >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Pipeline de Instagram
# ============================================================================

# Selecciona los temas del día y prepara imagen + caption. Diario 08:30 UTC,
# después del agregador. También difunde los artículos nuevos del blog.
30 8 * * * cd $APP_DIR && $DC exec -T api python -m scripts.instagram.prepare_daily >> /var/log/robelyrics-cron.log 2>&1

# Publica el siguiente post pendiente. 3 posts al día (08,14,20 UTC). SIN
# --force: respeta el cuentagotas (intervalo mínimo entre publicaciones), así
# no drena la cola hasta el relleno repetido cuando escasea la actualidad.
# OJO: el cron va en UTC y NO soporta CRON_TZ → horas en UTC para Madrid en
# VERANO (CEST=UTC+2): 08,14,20 → 10,16,22 Madrid. Al pasar a CET (UTC+1) el
# 26-oct-2026, cambiar a '0 9,15,21 * * *'.
0 8,14,20 * * * cd $APP_DIR && $DC exec -T api python -m scripts.instagram.publish_next >> /var/log/robelyrics-cron.log 2>&1

# Lote semanal de contenido EVERGREEN (frases, efemérides, anécdotas, citas).
# Lunes 07:45 UTC. Encola propuestas en estado `proposed` (sin publicar); el
# admin las aprueba en bloque desde el panel. Deduplica por content_key.
45 7 * * 1 cd $APP_DIR && $DC exec -T api python -m scripts.instagram.prepare_evergreen >> /var/log/robelyrics-cron.log 2>&1

# Email semanal de propuestas evergreen al admin. Lunes 09:50 UTC.
50 9 * * 1 cd $APP_DIR && $DC exec -T api python -m scripts.instagram.notify_evergreen >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Efemérides personales de Robe (publicación directa el día exacto)
# ============================================================================

# Cumpleaños Robe — 16 de mayo, 09:00 UTC
0 9 16 5 * cd $APP_DIR && $DC exec -T api python -m scripts.blog.publish_anniversary --type birth >> /var/log/robelyrics-cron.log 2>&1

# Aniversario muerte Robe — 10 de diciembre, 09:00 UTC
0 9 10 12 * cd $APP_DIR && $DC exec -T api python -m scripts.blog.publish_anniversary --type death >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Alimentación del banco de propuestas del blog (lunes)
# ============================================================================

# Consumidor del blog — lunes 09:00 UTC. Lee de news_items (las que tienen
# policy 'blog+ig'), reescribe con IA y crea propuestas (kind=news).
0 9 * * 1 cd $APP_DIR && $DC exec -T api python -m scripts.blog.scrape_news >> /var/log/robelyrics-cron.log 2>&1

# Generador de propuestas — lunes 09:20 UTC. Efemérides de discos próximas
# y evergreens de taxonomías. Ligero, sin IA, idempotente.
20 9 * * 1 cd $APP_DIR && $DC exec -T api python -m scripts.blog.generate_proposals >> /var/log/robelyrics-cron.log 2>&1

# Email semanal del banco — lunes 09:40 UTC. Manda al admin todas las
# propuestas en estado `proposed`, agrupadas por actualidad/repositorio.
40 9 * * 1 cd $APP_DIR && $DC exec -T api python -m scripts.blog.notify_proposals >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Materialización (diario): propuestas programadas → posts publicados
# ============================================================================

# Cada 5 min: red de seguridad que genera el borrador (cuerpo RAG) de las
# propuestas aprobadas que no lo tengan ya (aprobación en bloque, o un fallo
# de la generación síncrona al aprobar). Lo normal es que ya esté hecho.
*/5 * * * * cd $APP_DIR && $DC exec -T api python -m scripts.blog.generate_approved_drafts >> /var/log/robelyrics-cron.log 2>&1

# Cada día a las 08:00 UTC: las propuestas `scheduled` cuya fecha llegó se
# convierten en Post publicado (usa el borrador ya hecho, revalidate).
0 8 * * * cd $APP_DIR && $DC exec -T api python -m scripts.blog.materialize_proposals >> /var/log/robelyrics-cron.log 2>&1

# Cada día a las 08:15 UTC: los Posts que el admin programó a una fecha (estado
# `scheduled`, p.ej. desde /biblioteca/admin/posts) se publican al llegar su
# `scheduled_for` (con re-check del cap 2/sem, newsletter y revalidate).
15 8 * * * cd $APP_DIR && $DC exec -T api python -m scripts.blog.flush_scheduled_due >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Newsletter (digest semanal)
# ============================================================================

# Único envío semanal: domingo 12:00 UTC. `dispatch_to_all_confirmed` agrupa
# por suscriptor (last_sent_at) todo lo publicado en la semana en un solo
# correo. Ya NO se manda email on-publish (ver publishing.auto_publish_post).
0 12 * * 0 cd $APP_DIR && $DC exec -T api python -m scripts.blog.send_newsletter >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Link equity interno (semanal)
# ============================================================================

# Domingo 06:00 UTC: recalcula los enlaces internos entrantes por entidad
# (link_stats → snapshot en data/) y rebalancea el enlazado de todo el
# contenido potenciando las páginas más débiles, respetando la relevancia
# (relink_existing). El snapshot se copia a data/ (read-only en el contenedor)
# entre ambos pasos. Todo el bloque redirige a un único log.
0 6 * * 0 cd $APP_DIR && ( $DC exec -T api python -m scripts.seo.link_stats && docker cp robelyrics-api:/tmp/internal_link_stats.json $APP_DIR/data/internal_link_stats.json && $DC exec -T api python -m scripts.seo.relink_existing --revalidate ) >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Posts relevantes por página SEO ("En el diario") — semanal
# ============================================================================

# Domingo 05:00 UTC: recalcula los hasta 3 posts del blog más relevantes por
# página (híbrido entidades + semántica en posts_v1) y los escribe en
# data/related_posts.json. Reinicia el api para refrescar su caché en memoria
# (blip de 2-3s). Antes del rebalanceo de link equity (06:00).
0 5 * * 0 cd $APP_DIR && ( $DC exec -T api python -m scripts.seo.related_posts && docker cp robelyrics-api:/tmp/related_posts.json $APP_DIR/data/related_posts.json && $DC restart api ) >> /var/log/robelyrics-cron.log 2>&1

# ============================================================================
# Knowledge graph + embeddings VIVOS (frescura nocturna)
# ============================================================================
# 03:30 UTC: vectoriza material nuevo (fan-content + bios de entidades),
# reconstruye el grafo de conocimiento (entity_edges, idempotente) y audita la
# cobertura. Mantiene grafo y retrieval al día según crece el corpus, solo.
30 3 * * * cd $APP_DIR && ( $DC exec -T api python -m scripts.research.embed_interpretations && $DC exec -T api python -m scripts.graph.embed_entity_bios && $DC exec -T api python -m scripts.graph.build_graph && $DC exec -T api python -m scripts.graph.audit_embeddings ) >> /var/log/robelyrics-cron.log 2>&1
