# =============================================================
# RobeLyrics — variables de entorno
# Copia este fichero a .env y rellena los valores reales.
# NUNCA commitees .env (está en .gitignore).
# =============================================================

# ----- Postgres -----
POSTGRES_USER=robelyrics
POSTGRES_PASSWORD=changeme_robelyrics
POSTGRES_DB=robelyrics
POSTGRES_PORT=5435

# URL completa que usa la api (host=postgres dentro de la red docker)
DATABASE_URL=postgresql+psycopg://robelyrics:changeme_robelyrics@postgres:5432/robelyrics

# ----- Qdrant -----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333

# ----- API (FastAPI) -----
API_PORT=8001
API_LOG_LEVEL=info

# JWT — generar con: openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
JWT_ALGO=HS256
JWT_TTL_MIN=43200          # 30 días
BCRYPT_ROUNDS=12

# Usuario admin inicial (se sembrará en la migración de auth)
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=changeme_admin_password

# ----- Web (Next.js) -----
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8001

# ----- Servicios externos -----
# Genius API token: https://genius.com/api-clients (crear app, copiar Client Access Token)
GENIUS_TOKEN=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gate de relevancia de imágenes hero (visión gpt-4o). "1" (por defecto) verifica
# que la foto de cada post muestre a su sujeto antes de publicar; "0" lo desactiva.
# Sin OPENAI_API_KEY el gate se omite (no bloquea) para no romper entornos sin LLM.
HERO_VISION_GATE=1

# ----- DataForSEO (Google Images para fotos de posts/IG + volúmenes KW) -----
# Se leen en web_image.py / keyword_research.py. Sin ellas, la búsqueda de foto
# web degrada con elegancia (cae a Wikimedia/CC y, si no, a arte IA).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ----- Reddit (PRAW) — solo si se ejecuta scripts/research/fetch_reddit.py -----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=robelyrics-research/1.0 (by u/your_reddit_user)

# ----- YouTube Data API v3 — solo para fetch de comentarios destacados -----
YOUTUBE_API_KEY=

# ----- Ingesta de YouTube "1 click" (Juancares + entrevistas de Robe) -----
# INGEST_API_KEY: bearer compartido entre el daemon local de la Mac y los
# endpoints /ingest/youtube/* de prod. Generar con: openssl rand -hex 32
# DEBE ser el mismo valor en el .env de prod y en el entorno del daemon local.
INGEST_API_KEY=
# Solo el DAEMON LOCAL lo usa: base URL de la API de prod a la que empuja las
# transcripciones (la propia API de prod no necesita esta var).
PROD_API_URL=https://entreinteriores.com/api

# ----- Instagram (@entreinterioresrobe) — pipeline de publicación -----
# Credenciales de la app de Meta y de la cuenta IG Business. El token de
# acceso es de larga duración (~60 días): renovar antes de que caduque.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Posts de noticias al día (los del blog van aparte, con prioridad).
IG_POSTS_PER_DAY=2

# ----- Cloudinary — hosting público de las imágenes para la Graph API -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
